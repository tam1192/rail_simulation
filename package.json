{
    "name": "rail_simulation",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build --emptyOutDir",
        "check": "eslint .",
        "check:fix": "eslint . --fix",
        "fmt:check": "prettier --check .",
        "fmt": "prettier --write .",
        "type-check": "vue-tsc --strict --noEmit",
        "ci": "npm run check && npm run fmt:check && npm run type-check && npm run build"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "globals": "^17.9.0",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.41"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.10.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.66.0",
        "vite": "^8.2.1",
        "vue-tsc": "^3.3.9"
    }
}
